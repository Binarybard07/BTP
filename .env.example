# ==============================================================================
# QBEAST / BTP Strategy Environment Variables
# ==============================================================================

# Universe preset selection (e.g. nifty200_ddq, nifty50_ddq, nifty500_ddq, nifty100)
QBEAST_BACKTEST_UNIVERSE=nifty200_ddq

# Backtest date window (YYYY-MM-DD)
QBEAST_BACKTEST_START=2019-01-01
QBEAST_BACKTEST_END=2026-10-19

# Rebalance schedule ("monthly", "weekly", etc.)
REBALANCE_FREQ=monthly

# Data roots (relative to project root or absolute paths)
QBEAST_DATA_ROOT=data/Final_With_Survivorship_Data
QBEAST_MEMBERSHIP_ROOT=data/Survivorship_Bias

# Skip preflight check if running outside specific container/harness
REGIMESWITCH_SKIP_PREFLIGHT=1

# OpenAlgo Paper-Trading / Live Execution Configuration (Optional)
OPENALGO_API_KEY=your_openalgo_api_key_here
SERVICE_JSON=
SPREADSHEET_ID=
WORKSHEET_NAME=
